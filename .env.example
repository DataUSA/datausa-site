# Public base of the Tesseract OLAP API (trailing slash). Charts in the browser call this host directly.
NEXT_PUBLIC_TESSERACT_URL=https://api-ohio.datausa.io/
# Geoservice API used for geographic relations (parents, neighbors, intersects).
GEOSERVICE_URL=https://geoservice.datausa.io/api/
# Report photos: a folder holding splash/ and thumb/ (default: profile-images in the working
# directory, linked into the standalone build by scripts/package-standalone.sh). Not in Git.
# PROFILE_IMAGES_DIR=/srv/datausa/profile-images
# Only to take the photos from another host's /api/profile/... instead (e.g. https://datausa.io).
# NEXT_PUBLIC_IMAGE_BASE_URL=
# Canonical site origin used for metadata, canonical URLs and sitemaps.
SITE_URL=https://datausa.io
# Path to the dimensions SQLite database built by `npm run build:dimensions`.
DIMENSIONS_DB_PATH=./data/dimensions.sqlite
# Secret required by POST /api/revalidate to purge cached API data after a dataset release.
REVALIDATE_SECRET=
# Google Analytics 4 measurement id (optional; production uses G-9X03EHGTVS).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Show the EU cookie-consent banner (legacy CANON_GDPR).
NEXT_PUBLIC_GDPR=true
# PeoplePrism gated sections (optional; section is hidden when unset).
PRISM_DATABASE_URL=
PRISM_JWT_SECRET=
PRISM_COOKIE_DAYS=365

# Home page "Recent popular reports": most-viewed reports from Google Analytics 4 (Data API).
# Path to a service-account JSON key with read access to the property. Without it the home page
# uses its curated default tiles. GA_PROPERTY_ID defaults to the Data USA property.
# GA_KEYFILE=/etc/datausa/ga-service-account.json
# GA_PROPERTY_ID=402781720
# Bureau of Labor Statistics API key for the latest figures on /home-next (free; optional in dev,
# needed in production: without it BLS allows 25 requests a day per IP address).
# BLS_API_KEY=
